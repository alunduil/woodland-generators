{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"],
      "ignoreDependencies": ["jest", "prettier", "tsx"]
    },
    "packages/core": {
      "entry": ["src/logging/pino-pretty-transport.js", "test/**/*.test.ts"],
      "project": ["src/**/*.{ts,js}"]
    },
    "packages/foundry-module": {
      "entry": [
        "src/manifest.ts",
        "scripts/package-release.ts",
        "test/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/random": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
