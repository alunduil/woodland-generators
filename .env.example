# Copy to .env (gitignored). Every value here is optional: a foundry-data
# volume holding the build the pinned image asks for runs with no .env at all.
#
# The cache is keyed to an exact filename, foundryvtt-<version>.zip, so bumping
# the image in docker-compose.yml leaves the volume warm for the wrong version.
# docs/how-to/verify-foundry-module-with-docker-compose.md covers placing a
# build into the cache by hand, which needs no credentials.

# A timed download link for the Foundry build. Generate it from your Foundry
# account -> Purchased Software Licenses -> set OS to "Node.js" -> click the
# timed URL button. It expires, so generate it right before `docker compose
# up`.
FOUNDRY_RELEASE_URL=

# Install a build whose version differs from the pinned image's. The container
# warns about the mismatch and proceeds.
# FOUNDRY_VERSION=

# OPTIONAL: write the license on first run instead of typing it in the browser.
# May still need a one-time browser signature to activate.
# FOUNDRY_LICENSE_KEY=

# OPTIONAL: locks the running instance's /setup screens. Safe to omit on
# localhost; set any value to require it.
# FOUNDRY_ADMIN_KEY=

# Fallback instead of FOUNDRY_RELEASE_URL. Puts your password on disk, so
# prefer the release URL above. Ignored if FOUNDRY_RELEASE_URL is set.
# FOUNDRY_USERNAME=
# FOUNDRY_PASSWORD=
