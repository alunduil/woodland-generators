{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>alunduil/renovate-config:application",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "addLabels": ["automated"],
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Bump the mise.toml and packageManager pnpm pins in one PR so they cannot drift",
      "matchDepNames": ["pnpm"],
      "matchDepTypes": ["packageManager", "tools"],
      "groupName": "pnpm"
    },
    {
      "description": "Hold Foundry image updates for review because CI never starts Foundry, so a new build can break the module with every check green",
      "matchDepNames": ["felddy/foundryvtt"],
      "automerge": false,
      "prBodyNotes": [
        "**Before merging this Foundry build:**",
        "- [ ] Walk the scenarios in `packages/foundry-module/test/manual/` against it",
        "- [ ] Check that `compatibility.verified` in `packages/foundry-module/module.json` matches it",
        "- [ ] Check that `@league-of-foundry-developers/foundry-vtt-types` tracks it"
      ]
    },
    {
      "matchManagers": ["npm"],
      "addLabels": ["npm"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["actions"]
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "addLabels": ["docker"]
    },
    {
      "matchManagers": ["devcontainer"],
      "addLabels": ["devcontainer"]
    }
  ]
}
