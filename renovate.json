{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>alunduil/renovate-config:application",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "addLabels": ["automated"],
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Bump the mise.toml and packageManager pnpm pins in one PR so they cannot drift",
      "matchDepNames": ["pnpm"],
      "matchDepTypes": ["packageManager", "tools"],
      "groupName": "pnpm"
    },
    {
      "matchManagers": ["npm"],
      "addLabels": ["npm"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["actions"]
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "addLabels": ["docker"]
    },
    {
      "matchManagers": ["devcontainer"],
      "addLabels": ["devcontainer"]
    }
  ]
}
