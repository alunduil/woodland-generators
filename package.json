{
  "name": "woodland-generators",
  "version": "0.2.0",
  "description": "Workspace orchestrator for the Woodland Generators monorepo (core, foundry-module).",
  "author": "Alex Brandt",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.8.0 <12.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "eslint": "10.9.1",
    "jest": "30.4.2",
    "knip": "6.34.0",
    "npm-check-updates": "23.1.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "rm -rf packages/*/dist/",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "pnpm -r test:coverage",
    "prepare": "pnpm run build",
    "check:outdated": "pnpm outdated",
    "update:deps": "ncu"
  }
}
