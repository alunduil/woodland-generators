{
  "name": "woodland-generators",
  "version": "0.2.0",
  "description": "Workspace orchestrator for the Woodland Generators monorepo (core, foundry-module).",
  "author": "Alex Brandt",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.8.0 <13.0.0"
  },
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "10.12.0",
    "jest": "30.5.2",
    "knip": "6.41.0",
    "npm-check-updates": "23.1.1",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "rm -rf packages/*/dist/",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "pnpm -r test:coverage",
    "prepare": "pnpm run build",
    "check:outdated": "pnpm outdated",
    "update:deps": "ncu"
  }
}
