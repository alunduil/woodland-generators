{
  "name": "@woodland-generators/foundry-module",
  "version": "0.0.0",
  "description": "Foundry VTT module shell loading the Woodland Generators core into a live world",
  "author": "Alex Brandt",
  "license": "MIT",
  "private": true,
  "files": [
    "dist/",
    "languages/",
    "module.json",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.8.0"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:watch": "node esbuild.config.mjs --watch",
    "analyze:bundle": "bundle-analyzer dist --bundle-name=foundry-module --ignore-patterns '*.map' --dry-run",
    "clean": "rm -rf dist/",
    "install:dev": "node scripts/install-dev.mjs",
    "package": "tsx scripts/package-release.ts",
    "verify:release": "tsx scripts/verify-release.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "dependencies": {
    "@woodland-generators/random": "workspace:*"
  },
  "devDependencies": {
    "@codecov/bundle-analyzer": "2.0.1",
    "@league-of-foundry-developers/foundry-vtt-types": "13.346.0-beta.20250812191140",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.6",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "jest": "30.5.2",
    "jest-junit": "17.0.0",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3"
  }
}
